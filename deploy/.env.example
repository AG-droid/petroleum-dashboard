# Copy to deploy/.env to override. Defaults are fine for a laptop demo.

# Database credentials (local only; change before exposing anything).
POSTGRES_USER=prahari
POSTGRES_PASSWORD=prahari
POSTGRES_DB=prahari

# Where the dashboard is served. 127.0.0.1 = this laptop only.
# Set PRAHARI_BIND=0.0.0.0 to let devices on the same Wi-Fi open http://<laptop-ip>:8080
PRAHARI_BIND=127.0.0.1
PRAHARI_PORT=8080

# How often the demo feed posts tank-gauge and pump readings (seconds).
FEED_INTERVAL=30
